---
import { getCollection, getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "../components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { type FriendItem } from "../content/config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

const friendsData = await getEntry("data", "friends");
if (!friendsData) {
	throw new Error("Friends data not found: src/content/data/friends.json");
}
const items = friendsData.data as FriendItem[];
const friendUrls = items.map(item => item.siteurl);

// 读取 src/content/spec/friends/*.md，按 frontmatter.order 排序
const friendsPages = (await getCollection("spec"))
	.filter(page => page.id.startsWith("friends/"))
	.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

const renderedFriendsPages = await Promise.all(
	friendsPages.map(async page => ({
		page,
		Content: (await render(page)).Content,
	})),
);
---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
	<div class="flex flex-col gap-4">
		<!-- 友链列表卡片 -->
		<div class="card-base px-6 sm:px-9 py-6 sm:py-8">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
					{i18n(I18nKey.friends)}
				</h1>
				<button
					id="random-friend-link"
					class="btn-regular h-10 px-4 rounded-xl bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95 flex items-center gap-2"
					data-urls={JSON.stringify(friendUrls)}
					aria-label="随机友链"
				>
					<Icon
						name="fa6-solid:arrow-right-arrow-left"
						class="transition text-[var(--primary)] text-xl"
					/>
					<span class="text-sm font-medium">随机友链</span>
				</button>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="friends-list">
				{items.map((item) => (
					<a
						href={item.siteurl}
						target="_blank"
						rel="noopener noreferrer"
						class="friend-card group flex items-center gap-3 p-3 rounded-[var(--radius-large)] border border-black/10 dark:border-white/15 hover:border-[var(--primary)] active:scale-[0.98] transition-all duration-300"
						aria-label={`访问 ${item.title}`}
					>
						<div class="w-11 h-11 flex-shrink-0 rounded-full overflow-hidden border border-black/10 dark:border-white/15 bg-zinc-200 dark:bg-zinc-900">
							<img
								src={item.imgurl}
								alt={item.title}
								class="w-full h-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="min-w-0 flex-1 flex flex-col justify-center">
							<div class="font-bold text-sm text-neutral-900 dark:text-neutral-100 truncate group-hover:text-[var(--primary)] transition-colors">
								{item.title}
							</div>
							<div class="text-50 text-xs truncate mt-0.5">{item.desc}</div>
						</div>
					</a>
				))}
			</div>
		</div>

		<!-- spec/friends/*.md，每个文件一张卡片，标题取自 frontmatter.title -->
		{renderedFriendsPages.map(({ page, Content }) => (
			<div class="card-base px-6 sm:px-9 py-6 sm:py-8">
				<h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-4">
					{page.data.title ?? page.id}
				</h2>
				<div class="friends-md-body">
					<Markdown>
						<Content />
					</Markdown>
				</div>
			</div>
		))}
	</div>

	<script>
		window.addEventListener("DOMContentLoaded", () => {
			const randomFriendLink = document.getElementById("random-friend-link");
			if (randomFriendLink) {
				randomFriendLink.addEventListener("click", (e) => {
					e.preventDefault();
					const urls = JSON.parse(randomFriendLink.dataset.urls || "[]");
					if (urls.length === 0) return;
					const randomUrl = urls[Math.floor(Math.random() * urls.length)];
					window.open(randomUrl, "_blank", "noopener,noreferrer");
				});
			}
		});
	</script>

	<style is:global>
		.friends-md-body > :first-child > :first-child {
			margin-top: 0 !important;
		}
		.friends-md-body > :first-child > :last-child {
			margin-bottom: 0 !important;
		}
	</style>
</MainGridLayout>